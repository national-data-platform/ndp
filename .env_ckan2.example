#-------------------------
## CKAN2 .env_ckan2
# Container names
NGINX_CONTAINER_NAME=nginx
REDIS_CONTAINER_NAME=redis2
POSTGRESQL_CONTAINER_NAME=db2
SOLR_CONTAINER_NAME=solr2
DATAPUSHER_CONTAINER_NAME=datapusher2
CKAN_CONTAINER_NAME=ckan2
WORKER_CONTAINER_NAME=ckan-worker2

# Host Ports
CKAN_PORT_HOST=5000
NGINX_PORT_HOST=81
NGINX_SSLPORT_HOST=8443

# CKAN databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=db2
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db2/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db2/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db2/datastore

# Test database connections
TEST_CKAN_SQLALCHEMY_URL=postgres://ckan:ckan@db2/ckan_test
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://ckan:ckan@db2/datastore_test
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db2/datastore_test

# Dev settings
USE_HTTPS_FOR_DEV=false

# CKAN core
CKAN_VERSION=2.10.0
CKAN_SITE_ID=default
CKAN_SITE_URL=https://ndp-test.sdsc.edu
# CKAN_SITE_URL=http://localhost:8443
CKAN_PORT=5000
CKAN_PORT_HOST=5000
CKAN___ROOT__PATH=/catalog2
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME
# See https://docs.ckan.org/en/latest/maintaining/configuration.html#api-token-settings
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME
CKAN_SYSADMIN_NAME=CHANGE_ME
CKAN_SYSADMIN_PASSWORD=CHANGE_ME
CKAN_SYSADMIN_EMAIL=your_email@example.com
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=pass
CKAN_SMTP_MAIL_FROM=ckan@localhost
TZ=UTC

# Solr
SOLR_IMAGE_VERSION=2.10-solr9
CKAN_SOLR_URL=http://solr2:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://solr2:8983/solr/ckan

# Redis
REDIS_VERSION=6
CKAN_REDIS_URL=redis://redis2:6379/1
TEST_CKAN_REDIS_URL=redis://redis2:6379/1

# Datapusher
DATAPUSHER_VERSION=0.0.20
CKAN_DATAPUSHER_URL=http://datapusher2:8800
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://ckan2:5000
DATAPUSHER_REWRITE_RESOURCES=True
DATAPUSHER_REWRITE_URL=http://ckan2:5000

# NGINX
NGINX_PORT=80
NGINX_SSLPORT=443

# Extensions
CKAN__PLUGINS="envvars image_view text_view recline_view datastore datapusher ndp keycloak ndpcatalogadditions"
CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis2
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1


#-------------------------
## ckanext-keycloak
CKANEXT__KEYCLOAK__SERVER_URL=https://idp-test.nationaldataplatform.org
CKANEXT__KEYCLOAK__CLIENT_ID=
CKANEXT__KEYCLOAK__REALM_NAME=NDP
CKANEXT__KEYCLOAK__REDIRECT_URI=https://ndp-test.sdsc.edu/catalog/user/sso_login
CKANEXT__KEYCLOAK__CLIENT_SECRET_KEY=
CKANEXT__KEYCLOAK__LOGIN_GROUP=ckan_admin


#-------------------------
## ckanext-ndpcatalogadditions
CKANEXT__NDPCATALOGADDITIONS__API_KEY=
email_secret=